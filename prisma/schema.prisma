datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password_hash String
  date_birth    DateTime
  created_at    DateTime    @default(now())

  userPlaces    UserPlace[]
  places        Place[]     @relation("IdeaUserPlaces")

  MyVisitedPlace VisitedPlaces[]
}

model Place {
  id         String    @id @default(uuid()) 
  name          String
  location      String
  googlePlaceId String
  ideaUserId    String
  categoryId    String

  category      Category    @relation(fields: [categoryId], references: [id], name: "CategoryToPlace")
  user          User        @relation(fields: [ideaUserId], references: [id], name: "IdeaUserPlaces")
  userPlaces    UserPlace[]

  MyVisitedPlace VisitedPlaces[]
}


model UserPlace {
  userId     String
  placeId    String
  visited    Boolean
  active     Boolean  
  user       User     @relation(fields: [userId], references: [id])
  place      Place    @relation(fields: [placeId], references: [id])

  @@id([userId, placeId]) 
}

model VisitedPlaces {
  id            String   @id @default(uuid())
  userId        String
  placeId       String
  opinion       String
  wouldReturn   Boolean
  averageRating Float

  ratingAmbiente    Int
  ratingAtendimento Int
  ratingComida      Int
  ratingPreco       Int

  user  User  @relation(fields: [userId], references: [id])
  place Place @relation(fields: [placeId], references: [id])
}

model Category {
  id            String   @id @default(uuid())
  category_name String   @unique

  places        Place[]  @relation("CategoryToPlace")
}


